# Копировать в .env и заполнить
DATABASE_URL=postgresql+asyncpg://qa:qa@localhost:5432/qualix
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP=localhost:9092
ENVIRONMENT=development
SECRET_KEY=change-me-to-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI assertions: optional unless ai_assert is called; errors never become PASS.
# Providers: anthropic (default), openai, openai-compatible.
AI_PROVIDER=anthropic
# API root, including /v1 when required; blank uses the provider default.
AI_BASE_URL=
AI_API_KEY=
# Required for OpenAI-compatible providers; Anthropic keeps the existing default.
AI_MODEL=
# Legacy Anthropic configuration is still supported when AI_* values are blank.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Для авто-создания GitHub Issues при flaky тестах (опционально)
GITHUB_TOKEN=
CREATE_GH_ISSUES=0

# Grafana admin password (используется в docker-compose.yml)
GRAFANA_ADMIN_PASSWORD=changeme

# PostgreSQL credentials (используются в docker-compose.yml)
POSTGRES_USER=qa
POSTGRES_PASSWORD=qa
POSTGRES_DB=qualix
